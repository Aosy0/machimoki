{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "machimoki-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f2e7e6e725d64bbe8800ead054a4388b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COVERAGE_BUCKET",
      "bucket_name": "machimoki-coverage"
    }
  ],
  "vars": {
    "ORIGIN_URL": ""
  },
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "machimoki.aosy.f5.si/*",
      "zone_name": "aosy.f5.si"
    }
  ]
}
