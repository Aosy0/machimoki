{
  "name": "machimoki",
  "private": true,
  "workspaces": [
    "frontend",
    "worker",
    "core"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:worker": "npm run dev -w worker",
    "dev:api": "npm run dev -w core",
    "build": "npm run build -w core && npm run build -w frontend",
    "test": "npm run test -w core && npm run test -w frontend && npm run test -w worker",
    "test:core": "npm run test -w core",
    "test:frontend": "npm run test -w frontend",
    "test:worker": "npm run test -w worker",
    "test:watch": "npm run test:watch -w core",
    "test:file": "npm exec --workspace frontend -- vitest run",
    "test:e2e": "npm run test:e2e -w frontend",
    "test:e2e:ui": "npm run test:e2e:ui -w frontend",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "concurrently": "^9.1.2",
    "wrangler": "^4.127.0"
  }
}
