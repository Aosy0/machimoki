{
  "name": "machimoki",
  "private": true,
  "workspaces": [
    "frontend",
    "worker",
    "core"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:worker": "npm run dev -w worker",
    "dev:api": "npm run dev -w core",
    "build": "npm run build -w core && npm run build -w frontend",
    "test": "npm run test -w core"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.127.0"
  }
}
