{
  "name": "machimoki-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts MachimokiDemo out/machimoki-demo.mp4 --codec=h264 --crf=19 --pixel-format=yuv420p --muted --overwrite",
    "render:smoke": "remotion render src/index.ts SmokeTest out/smoke.mp4 --frames=0-89 --codec=h264 --crf=23 --pixel-format=yuv420p --overwrite"
  },
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "@remotion/fonts": "4.0.520",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
